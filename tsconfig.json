{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "rewriteRelativeImportExtensions": true,
        "outDir": "./dist",
        "types": ["node"]
    },
    "include": ["*.ts"],
    "exclude": ["node_modules", "dist"]
}
